# Copy this file to .env and fill in real values. Never commit .env.

PORT=8080
# Public URL of this site (used for DigiLocker redirect and secure cookies)
PUBLIC_URL=http://localhost:8080
# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# ---- Verification provider (PAN, GSTIN, vehicle registry, driving licence, bank) ----
# sandbox  = built-in test mode, no real checks, no cost
# cashfree = Cashfree Secure ID (government-authorised sources)
VERIFY_PROVIDER=sandbox
CASHFREE_ENV=sandbox            # sandbox | production
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=

# ---- DigiLocker (Aadhaar e-KYC and issued documents) ----
# sandbox = built-in test consent screen
# live    = real DigiLocker (needs an approved partner app)
DIGILOCKER_MODE=sandbox
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
# Must exactly match the redirect URI registered in the DigiLocker partner portal
DIGILOCKER_REDIRECT_URI=http://localhost:8080/api/digilocker/callback
